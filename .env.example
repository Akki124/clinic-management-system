# =======================================================
# CLINIC MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# =======================================================

# 1. Cloud PostgreSQL Database (Required on Vercel)
# Use a free cloud database from Neon.tech, Supabase.com, or Vercel Postgres:
DATABASE_URL=postgres://username:password@ep-your-database.neon.tech/neondb?sslmode=require

# 2. JWT Secret Key for Session Authentication (Required)
JWT_SECRET=clinic_super_secret_jwt_key_2026_secured!

# 3. Environment mode
NODE_ENV=production

# 4. Optional: If deploying Frontend separately to Vercel and Backend to Render/Railway
# VITE_API_URL=https://your-backend-api.onrender.com
